//--------------------------------------------------------------------------------------------------
bool lib1_gt_GroundZero_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto2CA48CDB_g;
    int auto2CA48CDB_u;
    unit auto2CA48CDB_var;

    // Actions
    if (!runActions) {
        return true;
    }

    lib1_gv_nuclearRaceActive = true;
    UnitAbilityEnable(UnitFromId(1893785244), "GroundZero", false);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printWarStrategyDominionGroundZero"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    lib1_gf_ModifyTension("dominion", "all", 5, "WarStratGroundZero");
    auto2CA48CDB_g = UnitGroup("AiurRockDebris2x2", c_playerAny, RegionFromId(21), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    auto2CA48CDB_u = UnitGroupCount(auto2CA48CDB_g, c_unitCountAll);
    for (;; auto2CA48CDB_u -= 1) {
        auto2CA48CDB_var = UnitGroupUnitFromEnd(auto2CA48CDB_g, auto2CA48CDB_u);
        if (auto2CA48CDB_var == null) { break; }
        Wait(RandomInt(5, 10), c_timeGame);
        libNtve_gf_ShowHideUnit(auto2CA48CDB_var, true);
        libNtve_gf_RescueUnit(EventUnit(), lib1_gv_dominionN, true);
    }
