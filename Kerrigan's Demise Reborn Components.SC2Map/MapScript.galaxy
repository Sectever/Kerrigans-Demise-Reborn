}

//--------------------------------------------------------------------------------------------------
// Trigger: Hyperjump Bhekar Ro
//--------------------------------------------------------------------------------------------------
bool lib1_gt_HyperjumpBhekarRo_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int auto415B97CA_val;

    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == lib1_gv_hyperjumpDialogItemBhekarRo))) {
            return false;
        }

        if (!((UnitIsAlive(UnitFromId(1052773404)) == true))) {
            return false;
        }

        if (!((((UnitGetOwner(UnitFromId(1052773404)) == lib1_gv_dominionN) && (lib1_gv_dominionRaynorWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_dominionN] == false)) || ((UnitGetOwner(UnitFromId(1052773404)) == lib1_gv_artanisN) && (lib1_gv_raynorProtossWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_artanisN] == false))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogSetVisible(lib1_gv_hyperjumpDialog, PlayerGroupSingle(EventPlayer()), false);
    UnitBehaviorAdd(UnitFromId(12710564), "HyperionIntializingHyperjumpWarp", UnitFromId(12710564), 1);
    UIDisplayMessage(PlayerGroupSingle(lib1_gv_raynorN), c_messageAreaDebug, StringExternal("DOCSTR_printHyperjumpInitiateBhekarRo"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_raynorN), 100.0, 0.0);
    ActorSend(libNtve_gf_MainActorofUnit(UnitFromId(12710564)), "AnimPlay Spell D 0 -1.000000 -1.000000 7.000000 AsDuration");
    Wait(3.0, c_timeGame);
    auto415B97CA_val = UnitGetOwner(UnitFromId(1052773404));
    if (auto415B97CA_val == lib1_gv_dominionN) {
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_dominionN), c_messageAreaDebug, StringExternal("DOCSTR_printHyperjumpIncomingDominion"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_dominionN), 100.0, 0.0);
    }
    else if (auto415B97CA_val == lib1_gv_artanisN) {
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_dominionN), c_messageAreaDebug, StringExternal("DOCSTR_printHyperjumpIncomingProtoss"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_dominionN), 100.0, 0.0);
    }
    else {
    }
    Wait(3.0, c_timeGame);
    UnitBehaviorAdd(UnitFromId(12710564), "HyperionHyperjumpTeleportOutDummy", UnitFromId(12710564), 1);
    SoundPlayOnUnitForPlayer(SoundLink("Battlecruiser_HyperJumpOut", -1), c_maxPlayers, PlayerGroupAll(), UnitFromId(12710564), 0.0, 100.0, 0.0);
    libNtve_gf_HideGameUI(false, PlayerGroupSingle(lib1_gv_raynorN));
    CutsceneFade(false, 1.0, Color(0,0,0), 100.0, PlayerGroupSingle(lib1_gv_raynorN), false);
    Wait(1.0, c_timeGame);
    CameraPan(EventPlayer(), PointFromId(2059795862), 0.0, -1, 10.0, false);
    CameraLockInput(EventPlayer(), true);
    ActorSend(libNtve_gf_MainActorofUnit(UnitFromId(12710564)), "SetOpacity 1.000000");
    ActorSend(libNtve_gf_MainActorofUnit(UnitFromId(12710564)), "AnimPlay Stand Work,One 0 -1.000000 -1.000000 3.000000 AsDuration");
    UnitSetPosition(UnitFromId(12710564), PointFromId(2059795862), false);
    libNtve_gf_HideGameUI(true, PlayerGroupSingle(lib1_gv_raynorN));
    UnitBehaviorAdd(UnitFromId(12710564), "HyperionFinishedHyperjumpWarp", UnitFromId(12710564), 1);
    CutsceneFade(true, 3.0, Color(0,0,0), 100.0, PlayerGroupSingle(lib1_gv_raynorN), false);
    Wait(3.0, c_timeGame);
    CameraLockInput(EventPlayer(), false);
    libNtve_gf_MakeUnitUncommandable(UnitFromId(12710564), false);
    UnitSelect(UnitFromId(12710564), EventPlayer(), true);
    return true;
}

