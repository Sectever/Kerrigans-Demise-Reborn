//--------------------------------------------------------------------------------------------------
// Trigger: Artanis Loyalty Counts
//--------------------------------------------------------------------------------------------------
bool lib1_gt_ArtanisLoyaltyCounts_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    string autoBBEAEA38_val;

    // Conditions
    if (testConds) {
        if (!((libNtve_gf_KillingPlayer() == lib1_gv_artanisN))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoBBEAEA38_val = UnitGetType(EventUnit());
    if (autoBBEAEA38_val == "ZealotAiur") {
        lib1_gv_fenixPoints += 1;
    }
    else if (autoBBEAEA38_val == "ImmortalAiur") {
        lib1_gv_kextorPoints += 1;
    }
    else if (autoBBEAEA38_val == "FenixMojoScout") {
        lib1_gv_ghostinaShellPoints += 1;
    }
    else if (autoBBEAEA38_val == "ZeratulSummonKarass") {
        lib1_gv_agrertonPoints += 1;
    }
    else {
    }
    if ((lib1_gv_fenixPoints >= 30) && (TechTreeUpgradeCount(lib1_gv_artanisN, "LoyaltyofZeal", c_techCountQueuedOrBetter) == 1)) {
        libNtve_gf_SetUpgradeLevelForPlayer(lib1_gv_artanisN, "LoyaltyofZeal", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(lib1_gv_raynorN, "LoyaltyofZeal", 1);
    }

    if ((lib1_gv_ghostinaShellPoints >= 75) && (TechTreeUpgradeCount(lib1_gv_artanisN, "LoyaltyofKhala", c_techCountQueuedOrBetter) == 1)) {
        libNtve_gf_SetUpgradeLevelForPlayer(lib1_gv_artanisN, "LoyaltyofKhala", 1);
    }

    if ((lib1_gv_agrertonPoints >= 40) && (TechTreeUpgradeCount(lib1_gv_artanisN, "LoyaltyofWisdom", c_techCountQueuedOrBetter) == 1) && (UnitIsAlive(UnitFromId(791061588)) == true) && (libNtve_gf_UnitIsHidden(UnitFromId(791061588)) == true)) {
        libNtve_gf_ShowHideUnit(UnitFromId(791061588), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventArtanisLoyaltyofWisdom], PlayerGroupAll(), true);
    }

    if ((lib1_gv_kextorPoints >= 100) && (TechTreeUpgradeCount(lib1_gv_artanisN, "LoyaltyofValor", c_techCountQueuedOrBetter) == 1) && (UnitIsAlive(UnitFromId(1934989527)) == true) && (libNtve_gf_UnitIsHidden(UnitFromId(1934989527)) == true)) {
        libNtve_gf_ShowHideUnit(UnitFromId(1934989527), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventArtanisLoyaltyofValor], PlayerGroupAll(), true);
    }

    if (((UnitIsAlive(UnitFromId(384430229)) == false) || (TechTreeUpgradeCount(lib1_gv_artanisN, "LoyaltyofZeal", c_techCountQueuedOrBetter) == 1)) && ((UnitIsAlive(UnitFromId(2037430932)) == false) || (TechTreeUpgradeCount(lib1_gv_artanisN, "LoyaltyofKhala", c_techCountQueuedOrBetter) == 1)) && ((UnitIsAlive(UnitFromId(2023875324)) == false) || (TechTreeUpgradeCount(lib1_gv_artanisN, "LoyaltyofWisdom", c_techCountQueuedOrBetter) == 1)) && ((UnitIsAlive(UnitFromId(432397889)) == false) || (TechTreeUpgradeCount(lib1_gv_artanisN, "LoyaltyofValor", c_techCountQueuedOrBetter) == 1))) {
        TriggerDestroy(TriggerGetCurrent());
    }

    return true;
}

