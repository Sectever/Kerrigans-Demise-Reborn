//--------------------------------------------------------------------------------------------------
// Trigger: Overmind Decimation Checks
//--------------------------------------------------------------------------------------------------
bool lib1_gt_OvermindDecimationChecks_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(UnitFromId(1810255279)) == true))) {
            return false;
        }

        if (!((lib1_gv_playerLostGame[lib1_gv_overmindN] == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((lib1_gv_overmindPivotedtoProtoss == false) && (lib1_gv_spawnAlive[lib1_gv_spawnAugustgrad] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnAugustgradUEDOccupied] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnKorhalSpacePort] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnKorhalSpacePortUEDOccupied] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnDominionPsiDisruptor] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnKorhalDecimated] == false) && (UnitIsAlive(UnitFromId(403939735)) == true) && ((lib1_gv_killedby1Terran2Protoss3Zerg[lib1_gv_spawnAugustgrad] == 3) || (lib1_gv_killedby1Terran2Protoss3Zerg[lib1_gv_spawnAugustgradUEDOccupied] == 3))) {
        libNtve_gf_ShowHideUnit(UnitFromId(1581740001), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventOvermindDecimateKorhal], PlayerGroupAll(), true);
    }

    if ((lib1_gv_overmindPivotedtoProtoss == false) && (lib1_gv_spawnAlive[lib1_gv_spawnUEDCommandHeadquarters] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnAlvacadaSpacePort] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnUEDSpaceStation] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnUEDPsiDisruptor] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnAlvacadaDecimated] == false) && (UnitIsAlive(UnitFromId(1441594554)) == true) && (lib1_gv_killedby1Terran2Protoss3Zerg[lib1_gv_spawnUEDCommandHeadquarters] == 3)) {
        libNtve_gf_ShowHideUnit(UnitFromId(497114139), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventOvermindDecimateAlvacada], PlayerGroupAll(), true);
    }

    if ((lib1_gv_overmindPivotedtoProtoss == false) && (lib1_gv_spawnAlive[lib1_gv_spawnCarthGrudenColony] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnCarthGrudenDecimated] == false) && (UnitIsAlive(UnitFromId(1053235320)) == true) && (lib1_gv_killedby1Terran2Protoss3Zerg[lib1_gv_spawnCarthGrudenColony] == 3)) {
        libNtve_gf_ShowHideUnit(UnitFromId(479661769), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventOvermindDecimateCarthGruden], PlayerGroupAll(), true);
    }

    if ((lib1_gv_overmindPivotedtoProtoss == true) && (lib1_gv_spawnAlive[lib1_gv_spawnProvinceofScion] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnAntiochDecimated] == true) && (lib1_gv_spawnAlive[lib1_gv_spawnProvinceofScionDecimated] == false) && (UnitIsAlive(UnitFromId(393291497)) == true) && (lib1_gv_killedby1Terran2Protoss3Zerg[lib1_gv_spawnProvinceofScion] == 3)) {
        libNtve_gf_ShowHideUnit(UnitFromId(1012022161), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventOvermindDecimateScion], PlayerGroupAll(), true);
    }

    if ((lib1_gv_overmindPivotedtoProtoss == true) && (lib1_gv_spawnAlive[lib1_gv_spawnStargatetoAiur] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnUelmorAdun] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnAiurDecimated] == false) && (UnitIsAlive(UnitFromId(372809771)) == true) && (lib1_gv_killedby1Terran2Protoss3Zerg[lib1_gv_spawnStargatetoAiur] == 3)) {
        libNtve_gf_ShowHideUnit(UnitFromId(1978386928), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventOvermindDecimateAiur], PlayerGroupAll(), true);
    }

    if ((lib1_gv_overmindPivotedtoProtoss == true) && (lib1_gv_spawnAlive[lib1_gv_spawnWarpgatetoShakuras] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnShakurasDecimated] == false) && (UnitIsAlive(UnitFromId(2140850527)) == true) && (lib1_gv_killedby1Terran2Protoss3Zerg[lib1_gv_spawnWarpgatetoShakuras] == 3)) {
        libNtve_gf_ShowHideUnit(UnitFromId(1893296431), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventOvermindDecimateShakuras], PlayerGroupAll(), true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void lib1_gt_OvermindDecimationChecks_Init () {
    lib1_gt_OvermindDecimationChecks = TriggerCreate("lib1_gt_OvermindDecimationChecks_Func");
    TriggerAddEventTimeElapsed(lib1_gt_OvermindDecimationChecks, 480.0, c_timeGame);
    TriggerAddEventTimeElapsed(lib1_gt_OvermindDecimationChecks, 720.0, c_timeGame);
    TriggerAddEventTimeElapsed(lib1_gt_OvermindDecimationChecks, 960.0, c_timeGame);
    TriggerAddEventTimeElapsed(lib1_gt_OvermindDecimationChecks, 1200.0, c_timeGame);
