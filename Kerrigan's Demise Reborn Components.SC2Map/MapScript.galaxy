void lib1_gf_SetTassadarLoyalty () {
    // Variable Declarations
    int lv_tassadarPoints;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if ((lib1_gv_spawnAlive[lib1_gv_spawnOvermind] == true) && (lib1_gv_playerLostGame[lib1_gv_overmindN] == false)) {
        lv_tassadarPoints += 3;
    }

    if ((lib1_gv_kerriganisDead == false) && (lib1_gv_playerLostGame[lib1_gv_kerriganN] == false)) {
        lv_tassadarPoints += 3;
    }

    if ((lib1_gv_zeratulisDead == false) && (lib1_gv_playerLostGame[lib1_gv_zeratulN] == false)) {
        lv_tassadarPoints += 2;
    }

    if ((lib1_gv_uEDProtossWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_uEDN] == false)) {
    }
    else {
        lv_tassadarPoints += 2;
    }
    if ((lib1_gv_playerLostGame[lib1_gv_duranN] == false) && ((TechTreeUnitCount(lib1_gv_duranN, "HybridDominatorVoid", c_techCountQueuedOrBetter) > 0) || (lib1_gv_eventConsumed[lib1_gv_eventZeratulQuest7ReturntotheConclave] == true))) {
        lv_tassadarPoints += 2;
    }

    if ((lib1_gv_spawnAlive[lib1_gv_spawnCerebrateKasz] == true) && (lib1_gv_playerLostGame[lib1_gv_cerebrateN] == false)) {
        lv_tassadarPoints += 1;
    }

    if ((lib1_gv_dominionProtossWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_dominionN] == false)) {
    }
    else {
        lv_tassadarPoints += 1;
    }
    if ((lib1_gv_raynorProtossWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_raynorN] == false)) {
    }
    else {
        lv_tassadarPoints += 1;
    }
    if ((lv_tassadarPoints >= 6)) {
        libNtve_gf_SetUpgradeLevelForPlayer(lib1_gv_artanisN, "LoyaltyofTemperance", 1);
    }
    else {
        libNtve_gf_SetUpgradeLevelForPlayer(lib1_gv_artanisN, "LoyaltyofTemperance", 0);
    }
    libNtve_gf_SetUnitInfoButtonButtonTooltip(UnitFromId(914592354), "LoyaltyofTemperance", (StringExternal("Button/Tooltip/LoyaltyofTemperance") + StringExternal("DOCSTR_printArtanisLoyaltyThreat") + IntToText(lv_tassadarPoints)));
    if ((TechTreeUnitCount(lib1_gv_artanisN, "CarrierTaldarim", c_techCountQueuedOrBetter) > 0)) {
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_artanisN), c_messageAreaDebug, (StringExternal("DOCSTR_printArtanisLoyaltyThreat") + IntToText(lv_tassadarPoints)));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_artanisN), 100.0, 0.0);
    }

}

