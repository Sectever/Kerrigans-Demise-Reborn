        lv_recipient = lib1_gv_kerriganN;
    }
    else if (autoE22EE1FE_val == "cer") {
        lv_recipient = lib1_gv_cerebrateN;
    }
    else if (autoE22EE1FE_val == "dur") {
        lv_recipient = lib1_gv_duranN;
    }
    else {
        lv_recipient = EventPlayer();
    }
    auto56B5FF17_g = UnitGroupSelected(EventPlayer());
    auto56B5FF17_u = UnitGroupCount(auto56B5FF17_g, c_unitCountAll);
    for (;; auto56B5FF17_u -= 1) {
