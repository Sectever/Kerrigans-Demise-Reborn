        }

        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_kerriganN)) {
            lib1_gv_kerriganN = lv_recipient;
        }

        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_cerebrateN)) {
            lib1_gv_cerebrateN = lv_recipient;
        }

        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_duranN)) {
            lib1_gv_duranN = lv_recipient;
        }

    }
    auto33814B88_g = lv_selectedPlayers;
    auto33814B88_var = -1;
    while (true) {
