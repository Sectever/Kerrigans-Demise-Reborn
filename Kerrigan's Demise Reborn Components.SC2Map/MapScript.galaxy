// Trigger: Dylarian Shipyards Lost
//--------------------------------------------------------------------------------------------------
bool lib1_gt_DylarianShipyardsLost_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto043B1870_g;
    int auto043B1870_u;
    unit auto043B1870_var;

    // Conditions
    if (testConds) {
        if (!((UnitTechTreeBehaviorCount(UnitFromId(178893817), "DylarianShipyardsUnderHeavyAttack", c_techCountQueuedOrBetter) == 1))) {
            return false;
        }

        if (!((EventUnitDamageSourcePlayer() == lib1_gv_uEDN))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto043B1870_g = UnitGroup("MissileTurret", c_playerAny, RegionFromId(48), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto043B1870_u = UnitGroupCount(auto043B1870_g, c_unitCountAll);
    for (;; auto043B1870_u -= 1) {
        auto043B1870_var = UnitGroupUnitFromEnd(auto043B1870_g, auto043B1870_u);
        if (auto043B1870_var == null) { break; }
        libNtve_gf_RescueUnit(auto043B1870_var, lib1_gv_uEDN, true);
    }
    libNtve_gf_RescueUnit(UnitFromId(178893817), lib1_gv_uEDN, true);
    UnitSetPropertyFixed(UnitFromId(178893817), c_unitPropLifePercent, 100.0);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printSpawnDestroyedDylarianUED"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    if ((libNtve_gf_UnitIsHidden(UnitFromId(1253968479)) == false) && (UnitIsAlive(UnitFromId(1253968479)) == true)) {
        libNtve_gf_ShowHideUnit(UnitFromId(1208718746), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventUEDDylarianRefit], PlayerGroupAll(), true);
    }

    if ((libNtve_gf_UnitIsHidden(UnitFromId(1338848044)) == false) && (UnitIsAlive(UnitFromId(1338848044)) == true)) {
        libNtve_gf_ShowHideUnit(UnitFromId(211830092), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventUEDDylarianBattlecruisers], PlayerGroupAll(), true);
    }

    UnitRemove(UnitFromId(1253968479));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventDominionDylarianRefit]);
    TriggerDestroy(lib1_gt_EventDominionDylarianRefit);
    UnitRemove(UnitFromId(1338848044));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventDominionDylarianBattlecruisers]);
    TriggerDestroy(lib1_gt_EventDominionDylarianBattlecruisers);
    UnitRemove(UnitFromId(203201232));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventDominionReinforceDylarianShipyards]);
    TriggerDestroy(lib1_gt_EventReinforceDylarianShipyards);
    UnitRemove(UnitFromId(1663930855));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventUEDClaimDylarianShipyards]);
    TriggerDestroy(lib1_gt_EventReinforceDylarianShipyards);
    lib1_gv_spawnsRemaining[lib1_gv_dominionN] -= 1;
    lib1_gv_spawnsRemaining[lib1_gv_uEDN] += 1;
    TriggerDestroy(TriggerGetCurrent());
    return true;
}

