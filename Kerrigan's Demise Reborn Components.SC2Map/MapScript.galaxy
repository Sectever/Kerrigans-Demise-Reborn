//--------------------------------------------------------------------------------------------------
void lib1_gt_MapInitializations_Init () {
    lib1_gt_MapInitializations = TriggerCreate("lib1_gt_MapInitializations_Func");
    TriggerAddEventMapInit(lib1_gt_MapInitializations);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Gametime-Based Event Initializations
//--------------------------------------------------------------------------------------------------
bool lib1_gt_GametimeBasedEventInitializations_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_overmindBasesDecimated;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(175.0, c_timeGame);
    UnitRemove(UnitFromId(1760449978));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventKerriganLostGhostConditioning]);
    TriggerDestroy(lib1_gt_EventKerriganLostGhostConditioning);
    Wait(60.0, c_timeGame);
    if ((UnitGetOwner(UnitFromId(1419953287)) == lib1_gv_uEDN)) {
        libNtve_gf_ShowHideUnit(UnitFromId(975120540), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventUEDBraxisResearch], PlayerGroupAll(), true);
    }

    libNtve_gf_ShowHideUnit(UnitFromId(533796347), true);
    TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventRaynorClaimRaiderOutpostAiur], PlayerGroupAll(), true);
    Wait(60.0, c_timeGame);
    lib1_gf_BaseClaimCheckMarchestoChar();
    lib1_gf_BaseClaimCheckSpireofAdun();
    lib1_gf_BaseClaimCheckAntigaPrimeTerran();
    lib1_gf_BaseClaimCheckAntigaPrimeProtoss();
    lib1_gf_BaseClaimCheckMarSara();
    libNtve_gf_ShowHideUnit(UnitFromId(181155904), true);
    TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventTerranRescueTarsonisRemnants], PlayerGroupAll(), true);
    Wait(60.0, c_timeGame);
    libNtve_gf_ShowHideUnit(UnitFromId(1638811294), true);
    TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventUEDTechRepairDeepSpaceComlink], PlayerGroupAll(), true);
    UnitRemove(UnitFromId(975120540));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventUEDBraxisResearch]);
    TriggerDestroy(lib1_gt_EventIncreasedBraxisResearch);
    Wait(60.0, c_timeGame);
    if ((lib1_gv_spawnAlive[lib1_gv_spawnUEDPsiDisruptor] == true)) {
        libNtve_gf_ShowHideUnit(UnitFromId(780297303), true);
        TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventUEDTechPsiDisruptorShields], PlayerGroupAll(), true);
    }

    libNtve_gf_ShowHideUnit(UnitFromId(1355941119), true);
    TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventZergDecimateCharAlephPlatform], PlayerGroupAll(), true);
    lib1_gf_BaseClaimCheckAntigaPrimeTerran();
    lib1_gf_BaseClaimCheckAntigaPrimeProtoss();
    Wait(60.0, c_timeGame);
    lib1_gf_BaseClaimCheckMarchestoChar();
    lib1_gf_BaseClaimCheckSpireofAdun();
    lib1_gf_BaseClaimCheckMarSara();
    UnitRemove(UnitFromId(1638811294));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventUEDTechRepairDeepSpaceComlink]);
    TriggerDestroy(lib1_gt_EventRepairComlink);
    UnitRemove(UnitFromId(533796347));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventRaynorClaimRaiderOutpostAiur]);
    TriggerDestroy(lib1_gt_EventClaimRaiderOutpostAiur);
    Wait(60.0, c_timeGame);
    UnitRemove(UnitFromId(780297303));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventUEDTechPsiDisruptorShields]);
    TriggerDestroy(lib1_gt_EventUEDPsiShields);
    Wait(60.0, c_timeGame);
    lib1_gf_BaseClaimCheckBhekarRoDecimated();
    lib1_gf_BaseClaimCheckKhyrador();
    libNtve_gf_ShowHideUnit(UnitFromId(216945698), true);
    TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventRaynorClaimRaiderOutpostKorhal], PlayerGroupAll(), true);
    if ((UnitAbilityCheck(UnitFromId(1810255279), "FinishHuntingHumanity", true) == true) && (UnitAbilityCheck(UnitFromId(1810255279), "RedirectingtoProtossEssence", true) == true)) {
        UnitAbilityEnable(UnitFromId(1810255279), "FinishHuntingHumanity", false);
