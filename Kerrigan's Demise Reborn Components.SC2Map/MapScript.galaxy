//--------------------------------------------------------------------------------------------------
// Trigger: Brood War Overmind
//--------------------------------------------------------------------------------------------------
bool lib1_gt_BroodWarOvermind_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int auto31B31C2F_val;

    // Actions
    if (!runActions) {
        return true;
    }

    UnitAbilityEnable(UnitFromId(686724326), "TheKingReigns", false);
    UnitAbilityEnable(UnitFromId(686724326), "TheQueenReigns", false);
    UnitAbilityEnable(UnitFromId(686724326), "RenegadePawn", false);
    UnitAbilityEnable(UnitFromId(1810255279), "TheCycleRestarts", false);
    UnitAbilityEnable(UnitFromId(145688367), "IgnitetheBroodWars", false);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printWarDeclareBroodOvermind"));
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, "Colgera", c_soundtrackCueAny, c_soundtrackIndexAny, false);
    Wait(5.0, c_timeGame);
    libNtve_gf_SetAlliance(lib1_gv_overmindN, lib1_gv_kerriganN, libNtve_ge_AllianceSetting_Enemy);
    auto31B31C2F_val = lib1_gv_cerebrateSide1Overmind2Kerrigan3Cerebrate;
    if (auto31B31C2F_val == 0) {
        libNtve_gf_SetAlliance(lib1_gv_cerebrateN, lib1_gv_kerriganN, libNtve_ge_AllianceSetting_Enemy);
    }
    else if (auto31B31C2F_val == 1) {
        libNtve_gf_SetAlliance(lib1_gv_cerebrateN, lib1_gv_kerriganN, libNtve_ge_AllianceSetting_Enemy);
    }
    else if (auto31B31C2F_val == 2) {
        libNtve_gf_SetAlliance(lib1_gv_cerebrateN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Enemy);
    }
    else if (auto31B31C2F_val == 3) {
        libNtve_gf_SetAlliance(lib1_gv_cerebrateN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(lib1_gv_cerebrateN, lib1_gv_kerriganN, libNtve_ge_AllianceSetting_Enemy);
    }
    else {
    }
    Wait(15.0, c_timeGame);
    if ((lib1_gv_broodWarActive == false)) {
        lib1_gv_broodWarActive = true;
        lib1_gf_ModifyTension("all", "all", 15, "Divergence");
    }

    return true;
}

