//--------------------------------------------------------------------------------------------------
// Trigger: Event - Kerrigan - Steal Raszagal
//--------------------------------------------------------------------------------------------------
bool lib1_gt_EventKerriganStealRaszagal_Func (bool testConds, bool runActions) {
    // Variable Declarations
    revealer lv_revealer;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((EventPlayer() == lib1_gv_kerriganN))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "K5Kerrigan"))) {
            return false;
        }

        if (!((libNtve_gf_UnitIsHidden(UnitFromId(1255561281)) == false))) {
            return false;
        }

        if (!((UnitIsAlive(UnitFromId(1255561281)) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(UnitFromId(1255561281));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventKerriganStealRaszagal]);
    lib1_gv_eventConsumed[lib1_gv_eventKerriganStealRaszagal] = true;
    libNtve_gf_MakeUnitInvulnerable(UnitFromId(1632278635), true);
    libNtve_gf_MakeUnitUncommandable(UnitFromId(1632278635), true);
    libNtve_gf_PauseUnit(UnitFromId(1632278635), true);
    UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printKerriganStealRaszagal1"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    Wait(1.0, c_timeGame);
    libNtve_gf_ShowHideUnit(UnitFromId(1632278635), false);
    VisRevealerCreate(lib1_gv_kerriganN, RegionFromId(33));
    lv_revealer = VisRevealerLastCreated();
    Wait(RandomFixed(10.0, 20.0), c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printKerriganStealRaszagal2"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    Wait(RandomFixed(10.0, 20.0), c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printKerriganStealRaszagal3"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    Wait(RandomFixed(2.0, 5.0), c_timeGame);
    VisRevealerEnable(lv_revealer, false);
    VisRevealerDestroy(lv_revealer);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printHeroDeployedInfestedRaszagal"));
    SoundPlayForPlayer(SoundLink("TransmissionRescueTextZerg", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    libNtve_gf_MakeUnitInvulnerable(UnitFromId(1632278635), false);
    libNtve_gf_MakeUnitUncommandable(UnitFromId(1632278635), false);
    libNtve_gf_PauseUnit(UnitFromId(1632278635), false);
    libNtve_gf_ShowHideUnit(UnitFromId(1632278635), true);
    libNtve_gf_SetUpgradeLevelForPlayer(lib1_gv_kerriganN, "EnslavedRaszagal", 1);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "VorazunChampion", 0, lib1_gv_kerriganN, UnitGetPosition(EventUnit()));
    lib1_gv_raszagalisaSlave = true;
    Wait(5.0, c_timeGame);
    if ((lib1_gv_zeratulisDead == false)) {
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_zeratulN), c_messageAreaDebug, StringExternal("DOCSTR_printDialogueZeratulRaszagalStolen"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_zeratulN), 100.0, 0.0);
    }

    Wait(10.0, c_timeGame);
    lib1_gf_ModifyTension("protoss", "all", -5, "KerrigansManipulation");
    TriggerDestroy(TriggerGetCurrent());
    return true;
}

