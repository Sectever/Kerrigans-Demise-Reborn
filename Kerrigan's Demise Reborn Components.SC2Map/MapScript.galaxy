        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_MakeUnitInvulnerable(EventUnit(), true);
    libNtve_gf_MakeUnitUncommandable(EventUnit(), true);
    libNtve_gf_PauseUnit(EventUnit(), true);
    UnitKill(UnitFromId(886935827));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventUEDBlackFlagInner]);
    lib1_gv_eventConsumed[lib1_gv_eventUEDBlackFlagInner] = true;
    if ((UnitGetType(EventUnit()) == "Scientist")) {
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_uEDN), c_messageAreaDebug, StringExternal("DOCSTR_printUEDBlackFlagSuccessScientist"));
    }
    else {
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_uEDN), c_messageAreaDebug, StringExternal("DOCSTR_printUEDBlackFlagSuccess"));
    }
    UnitAbilityEnable(UnitFromId(1810255279), "TheCycleRestarts", false);
    UnitAbilityEnable(UnitFromId(145688367), "IgnitetheBroodWars", false);
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_uEDN), 100.0, 0.0);
    libNtve_gf_SetAlliance(lib1_gv_uEDN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_AllyWithSharedVision);
    libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Enemy);
    if ((lib1_gv_dominionUEDWarActive == false)) {
        libNtve_gf_SetAlliance(lib1_gv_dominionN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Ally);
    }

    if ((lib1_gv_uEDRaynorWarActive == false)) {
        libNtve_gf_SetAlliance(lib1_gv_raynorN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Ally);
    }

    if ((lib1_gv_uEDProtossWarActive == false)) {
        libNtve_gf_SetAlliance(lib1_gv_artanisN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Ally);
        libNtve_gf_SetAlliance(lib1_gv_zeratulN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Ally);
    }

    lib1_gv_overmindisaSlave = true;
    Wait(1.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printUEDBlackFlagFinish"));
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, "CharFallsUnderUEDControl", c_soundtrackCueAny, c_soundtrackIndexAny, false);
    UnitAbilityEnable(UnitFromId(1906281768), "OperationShatteredSand", true);
    Wait(3.0, c_timeGame);
    if ((lib1_gv_speechEnabled[lib1_gv_speechIndexTheReckoning] == false)) {
        UnitAddChargeUsed(UnitFromId(1893785244), "PropagandaSpeechCharge", -1.0);
        lib1_gv_speechEnabled[lib1_gv_speechIndexTheReckoning] = true;
    }

    lib1_gf_ModifyTension("all", "ued", 20, "OvermindEnslavement");
    libNtve_gf_PauseUnit(EventUnit(), false);
    libNtve_gf_MakeUnitInvulnerable(EventUnit(), false);
    libNtve_gf_MakeUnitUncommandable(EventUnit(), false);
    lib1_gf_BaseClaimCheckCharResearchStation();
    Wait(7.0, c_timeGame);
    UnitAbilityEnable(UnitFromId(686724326), "TheKingReigns", false);
    UnitAbilityEnable(UnitFromId(686724326), "TheQueenReigns", false);
    UnitAbilityEnable(UnitFromId(686724326), "RenegadePawn", false);
    if ((lib1_gv_broodWarActive == false)) {
        autoC884E501_val = lib1_gv_cerebrateSide1Overmind2Kerrigan3Cerebrate;
        if (autoC884E501_val == 1) {
            libNtve_gf_SetAlliance(lib1_gv_uEDN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_AllyWithSharedVision);
            libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Enemy);
            lib1_gv_cerebrateisaSlave = true;
            if ((lib1_gv_dominionUEDWarActive == false)) {
                libNtve_gf_SetAlliance(lib1_gv_dominionN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Ally);
            }

            if ((lib1_gv_uEDRaynorWarActive == false)) {
                libNtve_gf_SetAlliance(lib1_gv_raynorN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Ally);
            }

            if ((lib1_gv_uEDProtossWarActive == false)) {
                libNtve_gf_SetAlliance(lib1_gv_artanisN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Ally);
                libNtve_gf_SetAlliance(lib1_gv_zeratulN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Ally);
            }

        }
        else if (autoC884E501_val == 2) {
            libNtve_gf_SetAlliance(lib1_gv_overmindN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Enemy);
        }
        else if (autoC884E501_val == 3) {
            libNtve_gf_SetAlliance(lib1_gv_overmindN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Enemy);
            libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Enemy);
        }
        else {
        }
        lib1_gv_broodWarActive = true;
        Wait(10.0, c_timeGame);
        lib1_gf_ModifyTension("all", "all", 15, "Divergence");
    }

    Wait(13.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(lib1_gv_uEDN), c_messageAreaDebug, StringExternal("DOCSTR_printHeroDeployedUEDZergHeroes"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_uEDN), 100.0, 0.0);
    libNtve_gf_CreateUnitsWithDefaultFacing(2, "HotSSwarmling", 0, lib1_gv_uEDN, PointFromId(1041838344));
    TriggerDestroy(TriggerGetCurrent());
    return true;
}

