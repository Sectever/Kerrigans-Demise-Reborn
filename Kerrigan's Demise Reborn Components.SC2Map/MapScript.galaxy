//--------------------------------------------------------------------------------------------------
// Trigger: Event - Medal of Arcturus Mengsk
//--------------------------------------------------------------------------------------------------
bool lib1_gt_EventMedalofArcturusMengsk_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_gameTextforMedal;

    // Automatic Variable Declarations
    string auto2FEED2DC_val;

    // Variable Initialization
    lv_gameTextforMedal = "DOCSTR_printDominionMedalArcturusMengsk";

    // Conditions
    if (testConds) {
        if (!((EventPlayer() == lib1_gv_dominionN))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "MarineWarfield") || (UnitGetType(EventUnit()) == "MengskSiegeTank") || (UnitGetType(EventUnit()) == "HHBattlecruiser") || (UnitGetType(EventUnit()) == "ImmortalTaldarim") || ((UnitGetType(EventUnit()) == "MengskGoliath") && (TechTreeUpgradeCount(lib1_gv_dominionN, "1StarGeneralAlanSchezar", c_techCountQueuedOrBetter) >= 1)) || ((UnitGetType(EventUnit()) == "MengskMarine") && (TechTreeUpgradeCount(lib1_gv_dominionN, "1StarGeneralCarterEvans", c_techCountQueuedOrBetter) >= 1)) || ((UnitGetType(EventUnit()) == "MengskFirebat") && (TechTreeUpgradeCount(lib1_gv_dominionN, "1StarGeneralGuiMontag", c_techCountQueuedOrBetter) >= 1)) || ((UnitGetType(EventUnit()) == "Nova") && (TechTreeUpgradeCount(lib1_gv_dominionN, "1StarGeneralNovaTerra", c_techCountQueuedOrBetter) >= 1)) || ((UnitGetType(EventUnit()) == "MengskWraith") && (TechTreeUpgradeCount(lib1_gv_dominionN, "1StarGeneralTomKazansky", c_techCountQueuedOrBetter) >= 1))))) {
            return false;
        }

        if (!((libNtve_gf_UnitIsHidden(UnitFromId(1306551929)) == false))) {
            return false;
        }

        if (!((UnitIsAlive(UnitFromId(1306551929)) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(UnitFromId(1306551929));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventDominionMedalofArcturusMengsk]);
    lib1_gv_eventConsumed[lib1_gv_eventDominionMedalofArcturusMengsk] = true;
    UnitBehaviorAdd(EventUnit(), "MedalofArcturusMengsk", EventUnit(), 1);
    auto2FEED2DC_val = UnitGetType(EventUnit());
    if (auto2FEED2DC_val == "MarineWarfield") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Horace");
    }
    else if (auto2FEED2DC_val == "MengskSiegeTank") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Edmund");
    }
    else if (auto2FEED2DC_val == "HHBattlecruiser") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Mengsk");
    }
    else if (auto2FEED2DC_val == "ImmortalTaldarim") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Mengsk");
    }
    else if (auto2FEED2DC_val == "MengskGoliath") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Alan");
    }
    else if (auto2FEED2DC_val == "MengskMarine") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Carter");
    }
    else if (auto2FEED2DC_val == "MengskFirebat") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Gui");
    }
    else if (auto2FEED2DC_val == "Nova") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Nova");
    }
    else if (auto2FEED2DC_val == "MengskWraith") {
        lv_gameTextforMedal = (lv_gameTextforMedal + "Tom");
    }
    else {
    }
    if ((lib1_gv_mengskisDead == true)) {
        lv_gameTextforMedal = (lv_gameTextforMedal + "NoMengsk");
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal(lv_gameTextforMedal));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    Wait(4.0, c_timeGame);
    lib1_gf_ModifyTension("dominion", "all", 3, "Medal");
    TriggerDestroy(TriggerGetCurrent());
    return true;
}

