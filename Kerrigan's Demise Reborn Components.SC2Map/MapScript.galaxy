    TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventZeratulLeaveSatellite], PlayerGroupAll(), false);
    libNtve_gf_ShowHideUnit(UnitFromId(483817113), true);
    TextTagShow(lib1_gv_eventTextTag[lib1_gv_eventRaynorClaimRaiderOutpostUlaan], PlayerGroupAll(), true);
    Wait(10.0, c_timeGame);
    lib1_gf_ModifyTension("all", "protoss", 3, "Expansion");
    TriggerDestroy(TriggerGetCurrent());
