//--------------------------------------------------------------------------------------------------
bool lib1_gt_EventTHEMAN_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventPlayer() == lib1_gv_raynorN))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "Raynor01") || (UnitGetType(EventUnit()) == "SJHyperion")))) {
            return false;
        }

        if (!((libNtve_gf_UnitIsHidden(UnitFromId(1556943431)) == false))) {
            return false;
        }

        if (!((UnitIsAlive(UnitFromId(1556943431)) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(UnitFromId(1556943431));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventRaynorTHEMAN]);
    lib1_gv_eventConsumed[lib1_gv_eventRaynorTHEMAN] = true;
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printRaynorTHEMAN"));
    SoundPlayForPlayer(SoundLink("TransmissionTextSC1Double", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    UnitBehaviorAdd(EventUnit(), "ImtheMan", EventUnit(), 1);
    TriggerDestroy(TriggerGetCurrent());
    return true;
}

