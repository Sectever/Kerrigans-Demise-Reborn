void lib1_gt_GametimeBasedEventInitializations_Init () {
    lib1_gt_GametimeBasedEventInitializations = TriggerCreate("lib1_gt_GametimeBasedEventInitializations_Func");
    TriggerAddEventTimeElapsed(lib1_gt_GametimeBasedEventInitializations, 5.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Hyperjump Initiate
//--------------------------------------------------------------------------------------------------
bool lib1_gt_HyperjumpInitiate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((lib1_gv_spawnAlive[lib1_gv_spawnBhekarRoDecimated] == true)) {
        libNtve_gf_SetDialogItemTooltip(lib1_gv_hyperjumpDialogItemBhekarRo, StringExternal("DOCSTR_guiHyperjumpBhekarRoZergUnavailable"), PlayerGroupAll());
    }
    else if (((lib1_gv_playerLostGame[UnitGetOwner(UnitFromId(1052773404))] == true) || (lib1_gv_spawnAlive[lib1_gv_spawnBhekarRo] == false))) {
        libNtve_gf_SetDialogItemTooltip(lib1_gv_hyperjumpDialogItemBhekarRo, StringExternal("DOCSTR_guiHyperjumpBhekarRoUnavailable"), PlayerGroupAll());
    }
    else if ((UnitGetOwner(UnitFromId(1052773404)) == lib1_gv_dominionN) && (lib1_gv_dominionRaynorWarActive == false)) {
        libNtve_gf_SetDialogItemTooltip(lib1_gv_hyperjumpDialogItemBhekarRo, StringExternal("DOCSTR_guiHyperjumpBhekarRoDominion"), PlayerGroupAll());
    }
    else if ((UnitGetOwner(UnitFromId(1052773404)) == lib1_gv_dominionN) && (lib1_gv_dominionRaynorWarActive == true)) {
        libNtve_gf_SetDialogItemTooltip(lib1_gv_hyperjumpDialogItemBhekarRo, StringExternal("DOCSTR_guiHyperjumpBhekarRoDominionUnavailable"), PlayerGroupAll());
    }
    else if ((UnitGetOwner(UnitFromId(1052773404)) == lib1_gv_artanisN) && (lib1_gv_raynorProtossWarActive == false)) {
        libNtve_gf_SetDialogItemTooltip(lib1_gv_hyperjumpDialogItemBhekarRo, StringExternal("DOCSTR_guiHyperjumpBhekarRoProtoss"), PlayerGroupAll());
    }
    else if ((UnitGetOwner(UnitFromId(1052773404)) == lib1_gv_artanisN) && (lib1_gv_raynorProtossWarActive == true)) {
        libNtve_gf_SetDialogItemTooltip(lib1_gv_hyperjumpDialogItemBhekarRo, StringExternal("DOCSTR_guiHyperjumpBhekarRoProtossUnavailable"), PlayerGroupAll());
    }
    if ((lib1_gv_spawnAlive[lib1_gv_spawnKorhalDecimated] == true) && (lib1_gv_spawnAlive[lib1_gv_spawnRaiderOutpostDominion] == true)) {
        libNtve_gf_SetDialogItemTooltip(lib1_gv_hyperjumpDialogItemKorhal, StringExternal("DOCSTR_guiHyperjumpKorhalZerg"), PlayerGroupAll());
