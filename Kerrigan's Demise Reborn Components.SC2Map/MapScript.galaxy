    lv_ententeTimerWindow = c_timerWindowNone;
    lv_kerriganTimerWindow = c_timerWindowNone;

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_uEDN, libNtve_ge_AllianceSetting_Neutral);
    if ((lib1_gv_overmindisaSlave == true)) {
        libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Neutral);
    }

