        UIDisplayMessage(PlayerGroupSingle(lib1_gv_artanisN), c_messageAreaDebug, StringExternal("DOCSTR_printTruceWarningKerrigan"));
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTruceWarningArtanis"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, libNtve_gf_UnionOfPlayerGroups(PlayerGroupSingle(lib1_gv_artanisN), PlayerGroupSingle(lib1_gv_kerriganN)), 100.0, 0.0);
    }

    libNtve_gf_WaitForTimer(lib1_gv_kerriganTruceTimer[3], 0.0, false);
    TimerWindowDestroy(lv_ententeTimerWindow);
    TimerWindowDestroy(lv_kerriganTimerWindow);
    if ((lib1_gv_playerLostGame[lib1_gv_artanisN] == false) && (lib1_gv_playerLostGame[lib1_gv_kerriganN] == false)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printTruceExpireArtanis"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
        Wait(RandomFixed(1.0, 5.0), c_timeGame);
        libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_artanisN, libNtve_ge_AllianceSetting_Enemy);
    }

    return true;
}

