    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printArtanisUltimatumBhekarRoRefused"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    lib1_gv_artanisRequestedBhekarRo = true;
    libNtve_gf_SetAlliance(lib1_gv_dominionN, lib1_gv_artanisN, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAlliance(lib1_gv_dominionN, lib1_gv_zeratulN, libNtve_ge_AllianceSetting_Enemy);
