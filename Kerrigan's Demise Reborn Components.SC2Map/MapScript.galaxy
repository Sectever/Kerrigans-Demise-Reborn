    lib1_gt_DetentewithDominion = TriggerCreate("lib1_gt_DetentewithDominion_Func");
    TriggerAddEventUnitAbility(lib1_gt_DetentewithDominion, UnitRefFromUnit(UnitFromId(145688367)), AbilityCommand("DetenteWithDominion", 0), c_unitAbilStageComplete, false);
