        if (auto56B5FF17_var == null) { break; }
        libNtve_gf_AddPlayerGroupToPlayerGroup(PlayerGroupSingle(UnitGetOwner(auto56B5FF17_var)), lv_selectedPlayers);
        lib1_gv_spawnsRemaining[lv_recipient] += lib1_gv_spawnsRemaining[UnitGetOwner(auto56B5FF17_var)];
        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_dominionN)) {
            lib1_gv_dominionN = lv_recipient;
        }

        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_uEDN)) {
            lib1_gv_uEDN = lv_recipient;
        }

        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_raynorN)) {
            lib1_gv_raynorN = lv_recipient;
        }

        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_artanisN)) {
            lib1_gv_artanisN = lv_recipient;
        }

        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_zeratulN)) {
            lib1_gv_zeratulN = lv_recipient;
        }

        if ((UnitGetOwner(auto56B5FF17_var) == lib1_gv_overmindN)) {
