//--------------------------------------------------------------------------------------------------
// Trigger: Random Tension
//--------------------------------------------------------------------------------------------------
bool lib1_gt_RandomTension_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_ententePlayers;
    int lv_zergPlayers;
    int lv_duranPlayer;
    int lv_tensionSelector;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(lib1_gv_randomTensionTimer, RandomFixed(200.0, 360.0), false, c_timeGame);
    if ((lib1_gv_playerLostGame[lib1_gv_dominionN] == false)) {
        lv_ententePlayers += 1;
    }

    if ((lib1_gv_playerLostGame[lib1_gv_uEDN] == false)) {
        lv_ententePlayers += 1;
    }

    if ((lib1_gv_playerLostGame[lib1_gv_raynorN] == false)) {
        lv_ententePlayers += 1;
    }

    if ((lib1_gv_playerLostGame[lib1_gv_artanisN] == false)) {
        lv_ententePlayers += 1;
    }

    if ((lib1_gv_playerLostGame[lib1_gv_zeratulN] == false)) {
        lv_ententePlayers += 1;
    }

    if ((lib1_gv_playerLostGame[lib1_gv_overmindN] == false)) {
        lv_zergPlayers += 1;
    }

    if ((lib1_gv_playerLostGame[lib1_gv_kerriganN] == false)) {
        lv_zergPlayers += 1;
    }

    if ((lib1_gv_playerLostGame[lib1_gv_cerebrateN] == false)) {
        lv_zergPlayers += 1;
    }

    if ((lib1_gv_playerLostGame[lib1_gv_duranN] == false)) {
        lv_duranPlayer += 1;
    }

    lv_tensionSelector = (lv_ententePlayers + lv_zergPlayers + lv_duranPlayer);
    lv_tensionSelector = RandomInt(1, (lv_ententePlayers + lv_zergPlayers + lv_duranPlayer));
    if ((lv_tensionSelector <= lv_ententePlayers)) {
        lib1_gf_ModifyTension("all", "all", 4, "Whispers");
    }
    else if ((lv_tensionSelector <= (lv_ententePlayers + lv_zergPlayers))) {
        lib1_gf_ModifyTension("all", "all", -3, "Cooperation");
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void lib1_gt_RandomTension_Init () {
    lib1_gt_RandomTension = TriggerCreate("lib1_gt_RandomTension_Func");
    TriggerAddEventTimer(lib1_gt_RandomTension, lib1_gv_randomTensionTimer);
}

