//--------------------------------------------------------------------------------------------------
// Trigger: Kerrigan Tension +5
//--------------------------------------------------------------------------------------------------
bool lib1_gt_KerriganTension5_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    lib1_gf_ModifyTension("all", "all", 5, "KerrigansManipulation");
    UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganGlobal"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    if ((TimerGetRemaining(lib1_gv_kerriganTruceTimer[0]) > 0.0)) {
        lib1_gf_ModifyTension("all", "dominion", 5, "KerriganTruce");
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganGlobalDominion"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    }

    if ((TimerGetRemaining(lib1_gv_kerriganTruceTimer[1]) > 0.0)) {
        lib1_gf_ModifyTension("all", "ued", 5, "KerriganTruce");
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganGlobalUED"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    }

    if ((TimerGetRemaining(lib1_gv_kerriganTruceTimer[2]) > 0.0)) {
        lib1_gf_ModifyTension("all", "raynor", 5, "KerriganTruce");
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganGlobalRaynor"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    }

    if ((TimerGetRemaining(lib1_gv_kerriganTruceTimer[3]) > 0.0)) {
        lib1_gf_ModifyTension("all", "protoss", 5, "KerriganTruce");
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganGlobalProtoss"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    }

    if ((TimerGetRemaining(lib1_gv_kerriganTruceTimer[4]) > 0.0)) {
        lib1_gf_ModifyTension("all", "protoss", 5, "KerriganTruce");
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganGlobalProtoss"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
    }

    return true;
}

