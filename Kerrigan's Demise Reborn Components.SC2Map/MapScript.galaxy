        libNtve_gf_RescueUnit2(UnitGroup(null, auto33814B88_var, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), lv_recipient, true);
    }
