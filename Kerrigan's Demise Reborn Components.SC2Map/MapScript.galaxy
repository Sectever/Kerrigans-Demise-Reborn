    lib1_gv_eventConsumed[lib1_gv_eventZeratulQuest3ClaimUlaanMoonbase] = true;
    autoBB896012_g = UnitGroup("PhotonCannon", c_playerAny, RegionFromId(35), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    autoBB896012_u = UnitGroupCount(autoBB896012_g, c_unitCountAll);
    for (;; autoBB896012_u -= 1) {
        autoBB896012_var = UnitGroupUnitFromEnd(autoBB896012_g, autoBB896012_u);
        if (autoBB896012_var == null) { break; }
        libNtve_gf_RescueUnit(autoBB896012_var, lib1_gv_zeratulN, true);
    }
    auto8EB803E6_g = UnitGroup("KhaydarinMonolith", c_playerAny, RegionFromId(35), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    auto8EB803E6_u = UnitGroupCount(auto8EB803E6_g, c_unitCountAll);
    for (;; auto8EB803E6_u -= 1) {
        auto8EB803E6_var = UnitGroupUnitFromEnd(auto8EB803E6_g, auto8EB803E6_u);
        if (auto8EB803E6_var == null) { break; }
        libNtve_gf_RescueUnit(auto8EB803E6_var, lib1_gv_zeratulN, true);
    }
    Wait(1.0, c_timeGame);
    libNtve_gf_ShowHideUnit(UnitFromId(1809834713), true);
    libNtve_gf_RescueUnit(UnitFromId(1809834713), lib1_gv_zeratulN, true);
