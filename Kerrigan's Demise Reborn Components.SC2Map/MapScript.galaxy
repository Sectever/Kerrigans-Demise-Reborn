bool lib1_gt_TensionCommand_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_string1;
    string lv_string2;
    int lv_amount;

    // Automatic Variable Declarations
    string autoBE6D6FE9_val;
    string autoE3DF1A7D_val;

    // Variable Initialization
    lv_string1 = "";
    lv_string2 = "";

    // Conditions
    if (testConds) {
        if (!(((PlayerHandle(EventPlayer()) == "1-S2-1-3179284") || (GameAttributeGameValue("2") == "0001") || (lib1_gv_gamemodeSandbox == true)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoBE6D6FE9_val = StringWord(EventChatMessage(false), 2);
    if (autoBE6D6FE9_val == "dom") {
        lv_string1 = "dominion";
    }
    else if (autoBE6D6FE9_val == "ued") {
        lv_string1 = "ued";
    }
    else if (autoBE6D6FE9_val == "ray") {
        lv_string1 = "raynor";
    }
    else if (autoBE6D6FE9_val == "pro") {
        lv_string1 = "protoss";
    }
    else if (autoBE6D6FE9_val == "all") {
        lv_string1 = "all";
    }
    else {
    }
    autoE3DF1A7D_val = StringWord(EventChatMessage(false), 3);
    if (autoE3DF1A7D_val == "dom") {
        lv_string2 = "dominion";
    }
    else if (autoE3DF1A7D_val == "ued") {
        lv_string2 = "ued";
    }
    else if (autoE3DF1A7D_val == "ray") {
        lv_string2 = "raynor";
    }
    else if (autoE3DF1A7D_val == "pro") {
        lv_string2 = "protoss";
    }
    else if (autoE3DF1A7D_val == "all") {
        lv_string2 = "all";
    }
    else {
    }
    lv_amount = StringToInt(StringWord(EventChatMessage(false), 4));
    lib1_gf_ModifyTension(lv_string1, lv_string2, lv_amount, "Commands");
    return true;
}

