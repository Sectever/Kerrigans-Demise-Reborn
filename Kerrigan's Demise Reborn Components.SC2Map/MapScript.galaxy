    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printTruceStartUED"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    UnitAbilityEnable(UnitFromId(145688367), "DetenteWithUED", false);
    TimerStart(lib1_gv_kerriganTruceTimer[1], 360.0, false, c_timeGame);
    TimerWindowCreate(lib1_gv_kerriganTruceTimer[1], StringExternal("DOCSTR_guiTimerDetenteKerrigan"), false, false);
    lv_ententeTimerWindow = TimerWindowLastCreated();
    TimerWindowCreate(lib1_gv_kerriganTruceTimer[1], StringExternal("DOCSTR_guiTimerDetenteUED"), false, false);
    lv_kerriganTimerWindow = TimerWindowLastCreated();
    TimerWindowShow(lv_ententeTimerWindow, PlayerGroupSingle(lib1_gv_uEDN), true);
    TimerWindowShow(lv_kerriganTimerWindow, PlayerGroupSingle(lib1_gv_kerriganN), true);
    libNtve_gf_WaitForTimer(lib1_gv_kerriganTruceTimer[1], 30.0, false);
    if ((lib1_gv_playerLostGame[lib1_gv_uEDN] == false) && (lib1_gv_playerLostGame[lib1_gv_kerriganN] == false)) {
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_uEDN), c_messageAreaDebug, StringExternal("DOCSTR_printTruceWarningKerrigan"));
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTruceWarningUED"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, libNtve_gf_UnionOfPlayerGroups(PlayerGroupSingle(lib1_gv_uEDN), PlayerGroupSingle(lib1_gv_kerriganN)), 100.0, 0.0);
    }

    libNtve_gf_WaitForTimer(lib1_gv_kerriganTruceTimer[1], 0.0, false);
    TimerWindowDestroy(lv_ententeTimerWindow);
    TimerWindowDestroy(lv_kerriganTimerWindow);
    if ((lib1_gv_playerLostGame[lib1_gv_uEDN] == false) && (lib1_gv_playerLostGame[lib1_gv_kerriganN] == false)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printTruceExpireUED"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
        Wait(RandomFixed(1.0, 5.0), c_timeGame);
        libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_uEDN, libNtve_ge_AllianceSetting_Enemy);
        if ((lib1_gv_overmindisaSlave == true)) {
            libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_overmindN, libNtve_ge_AllianceSetting_Neutral);
        }

        if ((lib1_gv_cerebrateisaSlave == true)) {
            libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_cerebrateN, libNtve_ge_AllianceSetting_Neutral);
        }

    }

    return true;
}

