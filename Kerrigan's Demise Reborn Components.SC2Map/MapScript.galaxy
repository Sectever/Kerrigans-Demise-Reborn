//--------------------------------------------------------------------------------------------------
// Trigger: Hyperjump Cancel
//--------------------------------------------------------------------------------------------------
bool lib1_gt_HyperjumpCancel_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == lib1_gv_hyperjumpDialogItemCancel))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogSetVisible(lib1_gv_hyperjumpDialog, PlayerGroupSingle(EventPlayer()), false);
    libNtve_gf_MakeUnitUncommandable(UnitFromId(12710564), false);
    UnitAbilityReset(UnitFromId(12710564), AbilityCommand("InitiateHyperspaceWarp", 0), c_spendLocationAll);
    UnitSetPropertyFixed(UnitFromId(12710564), c_unitPropEnergy, (UnitGetPropertyInt(UnitFromId(12710564), c_unitPropEnergy, c_unitPropCurrent) + 100));
    return true;
}

