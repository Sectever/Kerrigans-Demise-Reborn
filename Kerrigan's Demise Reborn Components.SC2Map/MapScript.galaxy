//--------------------------------------------------------------------------------------------------
// Trigger: Kerrigan Tension +8
//--------------------------------------------------------------------------------------------------
bool lib1_gt_KerriganTension8_Func (bool testConds, bool runActions) {
    // Variable Declarations
    bool lv_success;

    // Automatic Variable Declarations
    int autoF335D471_val;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    while ((lv_success == false)) {
        autoF335D471_val = RandomInt(1, 5);
        if (autoF335D471_val == 1) {
            if ((lib1_gv_dominionUEDWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_dominionN] == false) && (lib1_gv_playerLostGame[lib1_gv_uEDN] == false)) {
                lib1_gf_ModifyTension("dominion", "ued", 8, "KerrigansManipulation");
                UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganDominionUED"));
                SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
                lv_success = true;
            }

        }
        else if (autoF335D471_val == 2) {
            if ((lib1_gv_dominionProtossWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_dominionN] == false) && ((lib1_gv_playerLostGame[lib1_gv_artanisN] == false) || (lib1_gv_playerLostGame[lib1_gv_zeratulN] == false))) {
                lib1_gf_ModifyTension("dominion", "protoss", 8, "KerrigansManipulation");
                UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganDominionProtoss"));
                SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
                lv_success = true;
            }

        }
        else if (autoF335D471_val == 3) {
            if ((lib1_gv_uEDRaynorWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_uEDN] == false) && (lib1_gv_playerLostGame[lib1_gv_raynorN] == false)) {
                lib1_gf_ModifyTension("ued", "raynor", 8, "KerrigansManipulation");
                UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganUEDRaynor"));
                SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
                lv_success = true;
            }

        }
        else if (autoF335D471_val == 4) {
            if ((lib1_gv_uEDProtossWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_uEDN] == false) && ((lib1_gv_playerLostGame[lib1_gv_artanisN] == false) || (lib1_gv_playerLostGame[lib1_gv_zeratulN] == false))) {
                lib1_gf_ModifyTension("ued", "protoss", 8, "KerrigansManipulation");
                UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganUEDProtoss"));
                SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
                lv_success = true;
            }

        }
        else if (autoF335D471_val == 5) {
            if ((lib1_gv_dominionRaynorWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_dominionN] == false) && (lib1_gv_playerLostGame[lib1_gv_raynorN] == false) && (lib1_gv_raynorSidedwithDominion == false)) {
                lib1_gf_ModifyTension("dominion", "raynor", 8, "KerrigansManipulation");
                UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganDominionRaynor"));
                SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
                lv_success = true;
            }

            if ((lib1_gv_raynorProtossWarActive == false) && (lib1_gv_playerLostGame[lib1_gv_raynorN] == false) && ((lib1_gv_playerLostGame[lib1_gv_artanisN] == false) || (lib1_gv_playerLostGame[lib1_gv_zeratulN] == false)) && (lib1_gv_raynorSidedwithDominion == true)) {
                lib1_gf_ModifyTension("raynor", "protoss", 8, "KerrigansManipulation");
                UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTensionKerriganRaynorProtoss"));
                SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupSingle(lib1_gv_kerriganN), 100.0, 0.0);
                lv_success = true;
            }

        }
        else {
        }
    }
    return true;
}

