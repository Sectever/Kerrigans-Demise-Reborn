    TriggerAddEventUnitDied(lib1_gt_StructureDeaths, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Hero Deaths
//--------------------------------------------------------------------------------------------------
bool lib1_gt_HeroDeaths_Func (bool testConds, bool runActions) {
    // Variable Declarations
    bool lv_notaHero;
    point lv_spawnPoint;

    // Automatic Variable Declarations
    string auto9485EC08_val;
    int autoA786DC37_val;
    int auto986569CB_val;
    int autoE05430BA_val;
    unitgroup auto10A48653_g;
    int auto10A48653_u;
    unit auto10A48653_var;
    unitgroup auto7442D01E_g;
    int auto7442D01E_u;
    unit auto7442D01E_var;
    int auto06EDE925_val;
    int autoEB9FF602_val;
    int autoC3F93AA5_val;
    int auto4D43390A_val;
    int auto47F5ED06_val;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }

        if (!((UnitHasBehavior2(EventUnit(), "DontPrintDeathMessage") == false))) {
            return false;
        }

        if (!((EventPlayer() != 0))) {
            return false;
        }

        if (!((EventPlayer() != 15))) {
            return false;
