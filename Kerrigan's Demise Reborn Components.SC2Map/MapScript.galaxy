    else if ((((lib1_gv_spawnAlive[lib1_gv_spawnKorhalSpacePort] == false) && (lib1_gv_spawnAlive[lib1_gv_spawnKorhalSpacePortUEDOccupied] == false)) || ((lib1_gv_spawnAlive[lib1_gv_spawnKorhalSpacePort] == true) && (lib1_gv_playerLostGame[lib1_gv_dominionN] == true)) || ((lib1_gv_spawnAlive[lib1_gv_spawnKorhalSpacePortUEDOccupied] == true) && (lib1_gv_playerLostGame[lib1_gv_uEDN] == true)))) {
        libNtve_gf_SetDialogItemTooltip(lib1_gv_hyperjumpDialogItemKorhal, StringExternal("DOCSTR_guiHyperjumpKorhalUnavailable"), PlayerGroupAll());
    }
    else if ((lib1_gv_spawnAlive[lib1_gv_spawnKorhalSpacePort] == true) && (lib1_gv_spawnAlive[lib1_gv_spawnRaiderOutpostDominion] == true)) {
