// Trigger: Event - Black Flag Inner
//--------------------------------------------------------------------------------------------------
bool lib1_gt_EventBlackFlagInner_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int autoC884E501_val;

    // Conditions
    if (testConds) {
        if (!((EventPlayer() == lib1_gv_uEDN))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "Medivac") || (UnitGetType(EventUnit()) == "Scientist")))) {
