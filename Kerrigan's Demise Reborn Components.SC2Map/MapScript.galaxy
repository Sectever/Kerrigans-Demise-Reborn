// Trigger: Event - Stukov Secret Mission to Earth
//--------------------------------------------------------------------------------------------------
bool lib1_gt_EventStukovSecretMissiontoEarth_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    const int auto722120E5_ae = 10;
    int auto722120E5_var;

    // Conditions
    if (testConds) {
        if (!((EventPlayer() == lib1_gv_uEDN))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "Ghost_BlackOps"))) {
            return false;
        }

        if (!((libNtve_gf_UnitIsHidden(UnitFromId(2043067502)) == false))) {
            return false;
        }

        if (!((UnitIsAlive(UnitFromId(2043067502)) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(UnitFromId(2043067502));
    TextTagDestroy(lib1_gv_eventTextTag[lib1_gv_eventUEDSecretMissiontoEarth]);
    lib1_gv_eventConsumed[lib1_gv_eventUEDSecretMissiontoEarth] = true;
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printUEDStukovMissionDepart"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    libNtve_gf_PauseUnit(EventUnit(), true);
    libNtve_gf_MakeUnitInvulnerable(EventUnit(), true);
    libNtve_gf_ShowHideUnit(EventUnit(), false);
    Wait(RandomFixed(120.0, 240.0), c_timeGame);
    libNtve_gf_PauseUnit(EventUnit(), false);
    libNtve_gf_MakeUnitInvulnerable(EventUnit(), false);
    libNtve_gf_ShowHideUnit(EventUnit(), true);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printUEDStukovMissionReturn"));
    SoundPlayForPlayer(SoundLink("TransmissionTextSC1Double", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    UnitWeaponRemove(EventUnit(), "Ghost_BlackOps");
    UnitWeaponAdd(EventUnit(), "DSR55CanisterRifle", "AutoTurret");
    Wait(3.0, c_timeGame);
    SoundPlayForPlayer(SoundLink("Battlecruiser_Ready", 0), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    auto722120E5_var = 1;
    for ( ; auto722120E5_var <= auto722120E5_ae; auto722120E5_var += 1 ) {
        Wait(0.5, c_timeGame);
        libNtve_gf_UnitCreateFacingPoint(1, "Battlecruiser", 0, lib1_gv_uEDN, PointFromId(1800772082), PointFromId(1326062989));
        UnitBehaviorAdd(UnitLastCreated(), "SuperiorConstruction", UnitLastCreated(), 1);
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("AttackWithNeutralScanAirGround", 0), PointFromId(1392242191)), c_orderQueueReplace);
    }
    Wait(10.0, c_timeGame);
    lib1_gf_ModifyTension("ued", "all", 5, "UpgradeUED");
    TriggerDestroy(TriggerGetCurrent());
    return true;
}

