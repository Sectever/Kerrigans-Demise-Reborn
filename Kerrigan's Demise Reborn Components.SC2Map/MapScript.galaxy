//--------------------------------------------------------------------------------------------------
// Trigger: Detente with Dominion
//--------------------------------------------------------------------------------------------------
bool lib1_gt_DetentewithDominion_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_ententeTimerWindow;
    int lv_kerriganTimerWindow;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_ententeTimerWindow = c_timerWindowNone;
    lv_kerriganTimerWindow = c_timerWindowNone;

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_dominionN, libNtve_ge_AllianceSetting_Neutral);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printTruceStartDominion"));
    SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    UnitAbilityEnable(UnitFromId(145688367), "DetenteWithDominion", false);
    TimerStart(lib1_gv_kerriganTruceTimer[0], 360.0, false, c_timeGame);
    TimerWindowCreate(lib1_gv_kerriganTruceTimer[0], StringExternal("DOCSTR_guiTimerDetenteKerrigan"), false, false);
    lv_ententeTimerWindow = TimerWindowLastCreated();
    TimerWindowCreate(lib1_gv_kerriganTruceTimer[0], StringExternal("DOCSTR_guiTimerDetenteDominion"), false, false);
    lv_kerriganTimerWindow = TimerWindowLastCreated();
    TimerWindowShow(lv_ententeTimerWindow, PlayerGroupSingle(lib1_gv_dominionN), true);
    TimerWindowShow(lv_kerriganTimerWindow, PlayerGroupSingle(lib1_gv_kerriganN), true);
    libNtve_gf_WaitForTimer(lib1_gv_kerriganTruceTimer[0], 30.0, false);
    if ((lib1_gv_playerLostGame[lib1_gv_dominionN] == false) && (lib1_gv_playerLostGame[lib1_gv_kerriganN] == false)) {
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_dominionN), c_messageAreaDebug, StringExternal("DOCSTR_printTruceWarningKerrigan"));
        UIDisplayMessage(PlayerGroupSingle(lib1_gv_kerriganN), c_messageAreaDebug, StringExternal("DOCSTR_printTruceWarningDominion"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, libNtve_gf_UnionOfPlayerGroups(PlayerGroupSingle(lib1_gv_dominionN), PlayerGroupSingle(lib1_gv_kerriganN)), 100.0, 0.0);
    }

    libNtve_gf_WaitForTimer(lib1_gv_kerriganTruceTimer[0], 0.0, false);
    TimerWindowDestroy(lv_ententeTimerWindow);
    TimerWindowDestroy(lv_kerriganTimerWindow);
    if ((lib1_gv_playerLostGame[lib1_gv_dominionN] == false) && (lib1_gv_playerLostGame[lib1_gv_kerriganN] == false)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printTruceExpireDominion"));
        SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
        Wait(RandomFixed(1.0, 5.0), c_timeGame);
        libNtve_gf_SetAlliance(lib1_gv_kerriganN, lib1_gv_dominionN, libNtve_ge_AllianceSetting_Enemy);
    }

    return true;
}

