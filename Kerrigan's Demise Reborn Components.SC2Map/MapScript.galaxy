void lib1_gt_TerranUpgrades_Init () {
    lib1_gt_TerranUpgrades = TriggerCreate("lib1_gt_TerranUpgrades_Func");
    TriggerAddEventUnitResearchProgress(lib1_gt_TerranUpgrades, null, c_unitProgressStageComplete);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Protoss Upgrades
//--------------------------------------------------------------------------------------------------
bool lib1_gt_ProtossUpgrades_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unit auto3DD525DF_val;
    int autoB39832EC_val;
    int autoC958A12D_val;
    int auto953DFEC9_val;
    int auto4B1DA650_val;
    int auto0629716B_val;
    int autoAAB0F811_val;
    int auto2D25F377_val;
    int autoF8015589_val;
    int auto5F87494A_val;
    int auto39E9AC3A_val;
    int auto2BF3DA5D_val;
    int auto7F783BE0_val;
    int auto0E060A35_val;
    int auto0B61547E_val;
    int auto6A4CFA8A_val;

    // Conditions
    if (testConds) {
        if (!((libNtve_gf_TriggeringProgressUpgrade() == "UpgradeSpawnProtoss"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    MinimapPing(PlayerGroupSingle(EventPlayer()), UnitGetPosition(EventUnit()), 4.0, Color(100.00, 0.00, 0.00));
    PlayerModifyPropertyInt(EventPlayer(), c_playerPropVespene, c_playerPropOperAdd, 5000);
    lib1_gv_ententeTensionChance += 1;
    auto3DD525DF_val = EventUnit();
    if (auto3DD525DF_val == UnitFromId(1052773404)) {
        lib1_gv_spawnUpgrade[lib1_gv_spawnBhekarRo] += 1;
        autoB39832EC_val = lib1_gv_spawnUpgrade[lib1_gv_spawnBhekarRo];
        if (autoB39832EC_val == 3) {
            UnitAbilityEnable(UnitFromId(1052773404), "UpgradeSpawnMainProtoss", false);
        }
        else {
        }
    }
    else if (auto3DD525DF_val == UnitFromId(1419953287)) {
        lib1_gv_spawnUpgrade[lib1_gv_spawnKhyrador] += 1;
        autoC958A12D_val = lib1_gv_spawnUpgrade[lib1_gv_spawnKhyrador];
        if (autoC958A12D_val == 3) {
            UnitAbilityEnable(UnitFromId(1419953287), "UpgradeSpawnMainProtoss", false);
        }
        else {
        }
    }
    else if (auto3DD525DF_val == UnitFromId(714967404)) {
        lib1_gv_spawnUpgrade[lib1_gv_spawnProvinceofScion] += 1;
        auto953DFEC9_val = lib1_gv_spawnUpgrade[lib1_gv_spawnProvinceofScion];
        if (auto953DFEC9_val == 1) {
            SoundPlayForPlayer(SoundLink("TransmissionText", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
            libNtve_gf_ShowHideUnit(UnitFromId(384430229), true);
            libNtve_gf_RescueUnit(UnitFromId(384430229), EventPlayer(), true);
            if ((EventPlayer() == lib1_gv_zeratulN)) {
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringExternal("DOCSTR_printHeroDeployedFenixDLS"));
                Wait(5.0, c_timeGame);
                UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaDebug, StringExternal("DOCSTR_printHeroDeployedFenixDLS2"));
            }
